{
  "id": "iso8583-1987",
  "name": "ISO 8583:1987 Standard",
  "version": "1987",
  "description": "Standard ISO 8583:1987 Financial Transaction Card Originated Messages specification",
  "defaultHeaderLength": 10,
  "fields": {
    "1": { "fieldId": 1, "name": "Secondary Bitmap", "type": "BINARY_FIXED", "maxLength": 8, "description": "Indicates presence of DE 65-128" },
    "2": { "fieldId": 2, "name": "Primary Account Number (PAN)", "type": "LLVAR_NUMERIC", "maxLength": 19, "description": "Card Number" },
    "3": { "fieldId": 3, "name": "Processing Code", "type": "FIXED_NUMERIC", "maxLength": 6, "description": "Transaction type code (e.g. 000000 = Purchase)" },
    "4": { "fieldId": 4, "name": "Amount, Transaction", "type": "FIXED_NUMERIC", "maxLength": 12, "description": "Transaction amount in minor units" },
    "7": { "fieldId": 7, "name": "Transmission Date & Time", "type": "FIXED_NUMERIC", "maxLength": 10, "description": "MMDDhhmmss format" },
    "11": { "fieldId": 11, "name": "Systems Trace Audit Number (STAN)", "type": "FIXED_NUMERIC", "maxLength": 6, "description": "Unique sequence number for transaction tracing" },
    "12": { "fieldId": 12, "name": "Time, Local Transaction", "type": "FIXED_NUMERIC", "maxLength": 6, "description": "hhmmss format" },
    "13": { "fieldId": 13, "name": "Date, Local Transaction", "type": "FIXED_NUMERIC", "maxLength": 4, "description": "MMDD format" },
    "14": { "fieldId": 14, "name": "Date, Expiration", "type": "FIXED_NUMERIC", "maxLength": 4, "description": "YYMM format" },
    "22": { "fieldId": 22, "name": "Point of Service Entry Mode", "type": "FIXED_NUMERIC", "maxLength": 3, "description": "POS entry mode (e.g. 021 = Chip/PAN)" },
    "32": { "fieldId": 32, "name": "Acquiring Institution ID", "type": "LLVAR_NUMERIC", "maxLength": 11, "description": "Acquirer Identification Code" },
    "35": { "fieldId": 35, "name": "Track 2 Data", "type": "LLVAR_ALPHA", "maxLength": 37, "description": "Magstripe Track 2 data" },
    "37": { "fieldId": 37, "name": "Retrieval Reference Number (RRN)", "type": "FIXED_ALPHA", "maxLength": 12, "description": "Unique reference number" },
    "38": { "fieldId": 38, "name": "Authorization Identification Response", "type": "FIXED_ALPHA", "maxLength": 6, "description": "Approval Code from Issuer" },
    "39": { "fieldId": 39, "name": "Response Code", "type": "FIXED_ALPHA", "maxLength": 2, "description": "Action Code (00 = Approved, 51 = Insufficient Funds)" },
    "41": { "fieldId": 41, "name": "Card Acceptor Terminal ID (CATID)", "type": "FIXED_ALPHA", "maxLength": 8, "description": "Terminal Identification" },
    "42": { "fieldId": 42, "name": "Card Acceptor ID (CAID)", "type": "FIXED_ALPHA", "maxLength": 15, "description": "Merchant Identification" },
    "43": { "fieldId": 43, "name": "Card Acceptor Name/Location", "type": "FIXED_ALPHA", "maxLength": 40, "description": "Merchant Name & Address" },
    "48": { "fieldId": 48, "name": "Private Data", "type": "LLLVAR_ALPHA", "maxLength": 999, "description": "Custom network/issuer specific private data" },
    "49": { "fieldId": 49, "name": "Currency Code, Transaction", "type": "FIXED_NUMERIC", "maxLength": 3, "description": "ISO 4217 numeric currency code (e.g. 840 = USD)" },
    "52": { "fieldId": 52, "name": "Personal Identification Number (PIN) Data", "type": "BINARY_FIXED", "maxLength": 8, "description": "Encrypted PIN Block" },
    "55": { "fieldId": 55, "name": "Integrated Circuit Card (ICC) System Related Data", "type": "LLLVAR_ALPHA", "maxLength": 255, "description": "EMV Chip TLV data elements" },
    "70": { "fieldId": 70, "name": "Network Management Information Code", "type": "FIXED_NUMERIC", "maxLength": 3, "description": "NMIC (e.g. 001 = Logon, 301 = Echo Test)" },
    "90": { "fieldId": 90, "name": "Original Data Elements", "type": "FIXED_NUMERIC", "maxLength": 42, "description": "Used for Reversals (Original MTI, STAN, RRN)" },
    "102": { "fieldId": 102, "name": "Account Identification 1", "type": "LLVAR_ALPHA", "maxLength": 28, "description": "Source Account" },
    "103": { "fieldId": 103, "name": "Account Identification 2", "type": "LLVAR_ALPHA", "maxLength": 28, "description": "Destination Account" }
  }
}
